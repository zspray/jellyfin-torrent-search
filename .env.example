# ============================================
# Jellyfin Torrent Search - Configuração
# ============================================

# URL do seu servidor Jackett (normalmente localhost:9117)
JACKETT_URL=http://127.0.0.1:9117

# API Key do Jackett (encontre em: Jackett UI > canto superior direito)
JACKETT_API_KEY=SUA_API_KEY_AQUI

# Porta do servidor proxy (este backend)
PORT=3333

# URL do seu servidor Jellyfin (para CORS)
JELLYFIN_URL=http://127.0.0.1:8097

# ============================================
# Integração com cliente de torrent (opcional)
# ============================================

# qBittorrent
QBIT_URL=http://127.0.0.1:8080
QBIT_USER=admin
QBIT_PASS=adminadmin

# Pasta de download padrão (opcional)
DOWNLOAD_PATH=/downloads/movies
